{
  "openapi": "3.1.0",
  "info": {
    "title": "CRUD Users API",
    "version": "1.0.0",
    "description": "API para gerenciamento de usuários com operações CRUD"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Servidor local"
    }
  ],
  "tags": [
    {
      "name": "Users",
      "description": "Operações de gerenciamento de usuários"
    }
  ],
  "paths": {
    "/api/users": {
      "get": {
        "tags": ["Users"],
        "operationId": "listUsers",
        "summary": "Listar todos os usuários",
        "responses": {
          "200": {
            "description": "Lista de usuários",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "users": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/User" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Users"],
        "operationId": "createUser",
        "summary": "Criar novo usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserInput" },
              "example": {
                "name": "João Silva",
                "age": 25,
                "email": "joao@email.com"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuário criado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "400": {
            "description": "Requisição inválida",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Users"],
        "operationId": "updateUser",
        "summary": "Atualizar usuário (substituição completa)",
        "parameters": [
          { "$ref": "#/components/parameters/Id" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuário atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "400": {
            "description": "Requisição inválida",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "404": {
            "description": "Usuário não encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["Users"],
        "operationId": "partialUpdateUser",
        "summary": "Atualizar usuário (parcial)",
        "description": "Atualiza apenas os campos fornecidos",
        "parameters": [
          { "$ref": "#/components/parameters/Id" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserPartial" },
              "example": { "age": 26 }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuário atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "404": {
            "description": "Usuário não encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Users"],
        "operationId": "deleteUser",
        "summary": "Deletar usuário",
        "parameters": [
          { "$ref": "#/components/parameters/Id" }
        ],
        "responses": {
          "200": {
            "description": "Usuário deletado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "ID obrigatório",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "404": {
            "description": "Usuário não encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1,
            "readOnly": true
          },
          "name": {
            "type": "string",
            "example": "João Silva",
            "maxLength": 100
          },
          "age": {
            "type": "integer",
            "example": 25,
            "minimum": 1,
            "maximum": 150
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "joao@email.com"
          }
        },
        "required": ["id", "name", "age", "email"]
      },
      "UserInput": {
        "type": "object",
        "description": "Dados para criar ou atualizar um usuário",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "age": {
            "type": "integer",
            "minimum": 1,
            "maximum": 150
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": ["name", "age", "email"]
      },
      "UserPartial": {
        "type": "object",
        "description": "Dados parciais para atualização (PATCH) — todos os campos são opcionais",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "age": {
            "type": "integer",
            "minimum": 1,
            "maximum": 150
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Usuário não encontrado"
          }
        },
        "required": ["error"]
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "query",
        "required": true,
        "schema": {
          "type": "integer"
        },
        "description": "ID único do usuário",
        "example": 1
      }
    }
  }
}